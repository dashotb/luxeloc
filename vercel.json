{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "nodeVersion": "19.x",
        "maxLambdaSize": "50mb",
        "buildCommand": "npm run build",
        "installCommand": "npm install"
      }
    }
  ],
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "env": {
    "NODE_ENV": "production"
  },

  "routes": [
    {
      "src": "/vehicule/(.*)",
      "dest": "/vehicule/[id]",
      "continue": true
    }
  ]
}